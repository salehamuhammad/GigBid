---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	load(load)
	classify(classify)
	slots(slots)
	draft(draft)
	approval(approval)
	send(send)
	__end__([<p>__end__</p>]):::last
	__start__ --> load;
	approval -.-> __end__;
	approval -.-> send;
	classify -.-> __end__;
	classify -.-> draft;
	classify -.-> slots;
	draft -.-> __end__;
	draft -.-> approval;
	load -.-> __end__;
	load -.-> classify;
	slots -.-> __end__;
	slots -.-> draft;
	send --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
