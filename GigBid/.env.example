# Copy to .env. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for OAuth token encryption. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Storage. Leave blank for zero-dependency local mode (SQLite + in-process worker).
DATABASE_URL=
REDIS_URL=
QDRANT_URL=

# --- Marketplace. gigsim | upwork
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gigsim-dev-token

# --- MCP transport. inprocess (single process, no servers) | http (three servers)
MCP_TRANSPORT=inprocess
MCP_PORTFOLIO_URL=http://localhost:8101/mcp
MCP_MARKETPLACE_URL=http://localhost:8102/mcp
MCP_WORKSPACE_URL=http://localhost:8103/mcp

# --- Models. offline (no key, deterministic) | open | open_alt | open_local | paid
MODEL_PROFILE=offline
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=

# --- Third-party MCP servers
GITHUB_TOKEN=
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback

# --- Tracing (LangSmith). Optional; local run traces are always stored in the DB.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# --- Web
API_URL=http://localhost:8000
# Seeded reviewer account (password is set from this variable at seed time; do not commit a real value)
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=
