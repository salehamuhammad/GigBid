 "portfolio.search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "input": {
   "$defs": {
    "EvidenceFilters": {
     "properties": {
      "after": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Keep items dated on or after YYYY-MM-DD",
       "title": "After"
      },
      "client_industry": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Client Industry"
      },
      "outcome": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "For past proposals: won | replied | ignored",
       "title": "Outcome"
      },
      "skills": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Keep only items tagged with at least one of these skills",
       "title": "Skills"
      },
      "types": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "case_study",
           "repo",
           "review",
           "upload",
           "cv",
           "proposal"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Restrict to these evidence types. Default: case_study, repo, review, upload",
       "title": "Types"
      },
      "variant": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "RAG variant to use (default: the deployed one)",
       "title": "Variant"
      }
     },
     "title": "EvidenceFilters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/EvidenceFilters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "requirement": {
     "description": "One requirement in plain words, e.g. 'RAG chatbot over PDF documents'",
     "maxLength": 4000,
     "minLength": 2,
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "Evidence": {
     "properties": {
      "date": {
       "title": "Date",
       "type": "string"
      },
      "id": {
       "title": "Id",
       "type": "string"
      },
      "outcome": {
       "title": "Outcome",
       "type": "string"
      },
      "project": {
       "default": "",
       "title": "Project",
       "type": "string"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "skills": {
       "default": [],
       "items": {
        "type": "string"
       },
       "title": "Skills",
       "type": "array"
      },
      "snippet": {
       "title": "Snippet",
       "type": "string"
      },
      "source": {
       "title": "Source",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      },
      "type": {
       "title": "Type",
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "title",
      "source",
      "date",
      "outcome",
      "snippet",
      "score"
     ],
     "title": "Evidence",
     "type": "object"
    }
   },
   "properties": {
    "evidence": {
     "items": {
      "$ref": "#/$defs/Evidence"
     },
     "title": "Evidence",
     "type": "array"
    },
    "phrasing_examples": {
     "description": "Past proposals that won or got a reply. Wording inspiration only -- never proof of experience",
     "items": {
      "$ref": "#/$defs/Evidence"
     },
     "title": "Phrasing Examples",
     "type": "array"
    },
    "refused": {
     "default": false,
     "description": "True when retrieval found nothing strong enough: do NOT claim experience for this requirement",
     "title": "Refused",
     "type": "boolean"
    },
    "requirement": {
     "title": "Requirement",
     "type": "string"
    },
    "variant": {
     "default": "",
     "title": "Variant",
     "type": "string"
    }
   },
   "required": [
    "requirement",
    "evidence"
   ],
   "title": "SearchEvidenceResult",
   "type": "object"
  }
 },
