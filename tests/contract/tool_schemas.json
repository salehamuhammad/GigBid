{
 "marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "properties": {
    "bid_amount": {
     "description": "USD; total for fixed-price jobs, per hour for hourly jobs",
     "exclusiveMinimum": 0,
     "maximum": 1000000,
     "title": "Bid Amount",
     "type": "number"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 40,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Caller-chosen key. Repeating a call with the same key returns the first result and never sends or spends twice.",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9_.:\\-]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 3,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "maxLength": 2000,
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "$defs": {
    "ConnectsCost": {
     "properties": {
      "base": {
       "default": 0,
       "title": "Base",
       "type": "integer"
      },
      "policy_version": {
       "default": "",
       "title": "Policy Version",
       "type": "string"
      },
      "surcharge": {
       "default": 0,
       "title": "Surcharge",
       "type": "integer"
      },
      "total": {
       "default": 0,
       "title": "Total",
       "type": "integer"
      }
     },
     "title": "ConnectsCost",
     "type": "object"
    }
   },
   "properties": {
    "balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance After"
    },
    "connects": {
     "$ref": "#/$defs/ConnectsCost"
    },
    "connects_balance": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance"
    },
    "draft_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Draft Id"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "marketplace": {
     "default": "",
     "title": "Marketplace",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "dry_run only: the exact payload that would go to the marketplace",
     "title": "Would Send"
    }
   },
   "required": [
    "dry_run",
    "status"
   ],
   "title": "DraftResult",
   "type": "object"
  }
 },
